<% if (theme.post.math.engine === 'mathjax') { %>
  <%
    var lazy = theme.lazyload.enable && require_version(theme.static_prefix.mathjax, '3.2.0');
    import_script(`
      <script>
        if (!window.MathJax) {
          window.MathJax = {
            tex: { inlineMath: { '[+]': [['$', '$']] } },
            loader: { ${lazy ? "load: ['ui/lazy']" : ''} },
            options: {
              renderActions: {
                // Kramed emits v2 script nodes. Keep v3's default delimiter find.
                // https://docs.mathjax.org/en/v3.2/upgrading/v2.html
                findScript: [10, function (doc) {
                  for (const node of document.querySelectorAll('script[type^="math/tex"]')) {
                    if (node.closest('pre, code')) continue;
                    const display = /;\\s*mode=display/.test(node.type);
                    const math = new doc.options.MathItem(node.textContent, doc.inputJax[0], display);
                    const text = document.createTextNode('');
                    node.parentNode.replaceChild(text, node);
                    math.start = {node: text, delim: '', n: 0};
                    math.end = {node: text, delim: '', n: 0};
                    doc.math.push(math);
                  }
                }, ''],
                insertedScript: [200, function () {
                  document.querySelectorAll('mjx-container').forEach(function (node) {
                    const target = node.parentNode;
                    if (target.nodeName.toLowerCase() === 'li') target.parentNode.classList.add('has-jax');
                  });
                }, '', false]
              }
            }
          };
        }
        // Serialize refreshes after startup. Consumed scripts cannot register twice.
        function refreshMath() {
          if (!window.MathJax || !MathJax.startup) return;
          MathJax.startup.promise = MathJax.startup.promise.then(function () {
            MathJax.startup.document.state(0);
            MathJax.texReset();
            return MathJax.typesetPromise();
          }).catch(function (error) { console.error('MathJax typesetting failed', error); });
        }
        Fluid.events.registerRefreshCallback(refreshMath);
        if (window.MathJax.startup) refreshMath();
      </script>
      <style>
        .markdown-body mjx-container[display="true"] { overflow-x: auto; overflow-y: hidden; max-width: 100%; padding: 0.15em 0; }
      </style>
    `);
    import_js(theme.static_prefix.mathjax.replace('es5/', ''), 'es5/tex-mml-chtml.js');
  %>
<% } else if (theme.post.math.engine === 'katex') { %>
  <% import_css(theme.static_prefix.katex, 'katex.min.css'); %>
<% } %>
